// Este es un ejemplo básico de un plugin PaperMC en Java
package com.example.customcommand;

import org.bukkit.Bukkit;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.CommandSender;
import org.bukkit.entity.Player;
import org.bukkit.plugin.java.JavaPlugin;

public class CustomCommand extends JavaPlugin implements CommandExecutor {

    @Override
    public void onEnable() {
        this.getCommand("hola").setExecutor(this);
        getLogger().info("CustomCommand plugin habilitado.");
    }

    @Override
    public void onDisable() {
        getLogger().info("CustomCommand plugin deshabilitado.");
    }

    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (sender instanceof Player) {
            Player player = (Player) sender;
            player.sendMessage("¡Hola, " + player.getName() + "!");
            return true;
        }
        sender.sendMessage("Este comando solo puede usarse por jugadores.");
        return false;
    }
}